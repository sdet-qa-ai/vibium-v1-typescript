{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "moduleResolution": "node",
  
      "rootDir": "./src",
      "outDir": "./dist",
  
      "types": ["node", "mocha", "chai"],
  
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "verbatimModuleSyntax": false
    }
  }